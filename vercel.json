{
  "version": 2,
  "builds": [
    {
      "src": "backend/index.ts",
      "use": "@vercel/node"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "backend/index.ts"
    },
    {
      "source": "/planner",
      "destination": "frontend/index.html"
    },
    {
      "source": "/videos",
      "destination": "frontend/index.html"
    },
    {
      "source": "/categories",
      "destination": "frontend/index.html"
    },
    {
      "source": "/channels",
      "destination": "frontend/index.html"
    },
    {
      "source": "/admin",
      "destination": "frontend/index.html"
    },
    {
      "source": "/create-idea",
      "destination": "frontend/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "frontend/$1"
    }
  ]
}
